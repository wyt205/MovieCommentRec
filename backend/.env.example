# 复制本文件为 .env 并填入你的 MySQL 连接信息
# 格式：mysql+pymysql://<用户>:<密码>@<主机>:<端口>/<库名>?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/llm_pro?charset=utf8mb4

# ---- 大模型（Agent 大脑）配置 ----
# 模型待定时三项全部留空即可，后端照常启动，仅 /api/agent/chat 返回「未启用」提示。
# 支持任意 OpenAI 兼容协议：GLM-4-Flash / 讯飞 Ultra / GPT 等。
# 示例（智谱 GLM-4-Flash，永久免费）：
#   LLM_API_KEY=你的_zhipu_key
#   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   LLM_MODEL=glm-4-flash
# 示例（讯飞 Ultra，注意 Lite 不支持 function calling）：
#   LLM_API_KEY=你的_xfyun_key
#   LLM_BASE_URL=https://spark-api-open.xf-yun.com/v1
#   LLM_MODEL=generalv3.5
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=glm-4-flash

# ---- 嵌入模型（RAG 语义检索）----
# 星火 MaaS 免费 Qwen3-Embedding-8B（OpenAI 兼容），用于「按剧情/主题语义搜电影」。
# key 为「appId:secret」整串，鉴权用 Bearer <整串>；base_url 写到 /v2（SDK 自动补 /embeddings）。
# 示例：
#   EMBEDDING_API_KEY=你的_xfyun_maas_key（含冒号整串）
#   EMBEDDING_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
#   EMBEDDING_MODEL=xop3qwen8bembedding
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
EMBEDDING_MODEL=xop3qwen8bembedding

